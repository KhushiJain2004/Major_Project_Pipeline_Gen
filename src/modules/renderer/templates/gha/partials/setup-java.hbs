- name: Set up Java {{#if matrix.java_versions}}({{expr "matrix.node"}}){{else}}({{java_version}}){{/if}}
  uses: actions/setup-java@v4
  with:
    distribution: 'temurin'
    java-version: {{#if matrix.java_versions}}{{expr "matrix.node"}}{{else}}"{{java_version}}"{{/if}}
    cache : '{{package_manager}}'